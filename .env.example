# --- Required ---
DATABASE_URL=postgresql://voice:voice@localhost:5432/voice_campaign
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Public https base URL of THIS app (no trailing slash). The telephony
# provider must be able to reach it: it fetches /audio/<token>.mp3 and posts
# call status to /webhooks/call-status/<id>.
PUBLIC_BASE_URL=https://voice.example.com

# --- Telephony ---
# mock = no real calls (simulated outcomes, safe default); twilio = real calls.
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Tuning ---
DEFAULT_COUNTRY_CODE=91
CALLS_PER_SECOND=1
# Assumed per-billed-minute rate used for cost estimates (editable per campaign).
COST_PER_MINUTE=1.0
